NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# New key names (preferred): sb_publishable_... / sb_secret_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy fallbacks (still supported by lib/supabase.ts):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SITE_URL=https://waitlist.uniui.com.ng
NEXT_PUBLIC_PANTERO_URL=https://pantero.vercel.app
WHATSAPP_COMMUNITY_LINK=https://chat.whatsapp.com/your-invite-link
WHATSAPP_CHANNEL_LINK=https://whatsapp.com/channel/your-channel-link
NEXT_PUBLIC_EMAIL=your-email@example.com
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/your-group-link

ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# --- Telegram Rewards Mini App / Bot ---
# Token from @BotFather. Required for: verifying Mini App initData,
# broadcasting messages, and the referral confirmation flow.
BOT_TOKEN=your_telegram_bot_token
# Public username of the bot (without the @). Used to redirect users who
# open /rewards outside Telegram.
NEXT_PUBLIC_BOT_USERNAME=UniUIRewardsBot
# Secret sent by Telegram as X-Telegram-Bot-Api-Secret-Token to /api/telegram/webhook.
# Must be set BEFORE running scripts/set-webhook.mjs (it is registered with setWebhook).
TELEGRAM_WEBHOOK_SECRET=generate_a_long_random_string
# Base URL of the deployed app — used by scripts/setup-telegram.mjs to register
# the webhook AND set the bot's menu button web_app URL. Must be your real
# production domain (not a placeholder):
NEXT_PUBLIC_SITE_URL=https://waitlist.uniui.com.ng

# Reward economics (documented for ops reference; the live values live in code)
# - Cash spin: ₦200–₦10,000, paid immediately to the wallet.
# - First 2 spinners get a guaranteed ₦1,000 on their first spin.
# - Tokens: 500 tokens per 7 verified referrals, granted at AI launch.